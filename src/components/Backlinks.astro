---
// Backlinks — このノートを本文中で言及しているノート（Obsidian の linked mentions 相当）。
// 目録（Moc）経由の所属はパンくずが示すので、ここに出すのは本文の横リンクだけ。
import { backlinksFor } from '../../plugins/wikilinks.mjs';

const route = (Astro.locals as any)?.starlightRoute;
const raw: string = route?.id ?? route?.entry?.id ?? '';
const slug = raw === 'index' ? '' : raw.replace(/\/index$/, '');

const linking = backlinksFor(slug);
---

{
  linking.length > 0 && (
    <aside class="backlinks" aria-label="このノートへのリンク">
      <h2>リンクしているノート</h2>
      <ul>
        {linking.map((n) => (
          <li>
            <a class="wikilink" href={n.slug === '' ? '/' : `/${n.slug}/`}>
              {n.title}
            </a>
          </li>
        ))}
      </ul>
    </aside>
  )
}
