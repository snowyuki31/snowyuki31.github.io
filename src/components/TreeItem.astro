---
// TreeItem — Index ツリーの 1 ノード（再帰）。
// 親もリンク（クリックでそのページへ）、開閉は caret 側で行う。
//
// 開閉の初期状態: 現在ページの祖先チェーン上のノード（と現在ページ自身）だけ開く。
// これで「第 1 階層は常に表示・親にいれば子まで・深くにいれば同層と root までの道」になる。
interface Props {
  node: { title: string; slug: string; children: any[] };
  current: string;
  open: Set<string>;
}
const { node, current, open } = Astro.props;
const href = node.slug === '' ? '/' : `/${node.slug}/`;
const aria = current === node.slug ? 'page' : undefined;
---

<li>
  {
    node.children.length > 0 ? (
      <details open={open.has(node.slug)}>
        <summary>
          <a href={href} aria-current={aria}>{node.title}</a>
          <span class="kb-caret" aria-hidden="true" />
        </summary>
        <ul>
          {node.children.map((c) => (
            <Astro.self node={c} current={current} open={open} />
          ))}
        </ul>
      </details>
    ) : (
      <a href={href} aria-current={aria}>{node.title}</a>
    )
  }
</li>
