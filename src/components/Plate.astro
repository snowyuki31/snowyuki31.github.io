---
// Plate — 定義・命題・定理などの「主張のプレート」。
//
// ノートは atomic（1 ノート 1 概念）なので、ノートをまたぐ通し番号は振らない。
// ラベルは「定義（圏）」のように種別＋タイトルで示し、参照は [[wikilink]] で行う。
interface Props {
  kind: string;
  title?: string;
  id?: string;
}
const { kind, title, id } = Astro.props;
const label = title ? `${kind}（${title}）` : kind;
---

<div class="plate" id={id}>
  <p class="plate-head">
    <span class="plate-label">{kind}</span>
    {title && <span class="plate-title">（{title}）</span>}
    {
      id && (
        <a class="plate-anchor" href={`#${id}`} aria-label={`${label}へのリンク`}>
          #
        </a>
      )
    }
  </p>
  <div class="plate-body"><slot /></div>
</div>
