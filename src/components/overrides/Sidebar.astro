---
// Sidebar override — 左サイドバー = 全ノートの Index。
// header は 2 カラム以上で消すので、左上が Home へのリンク（wordmark）になる。
import { scanNotes } from '../../../plugins/wikilinks.mjs';

const route = (Astro.locals as any)?.starlightRoute;
const raw: string = route?.id ?? route?.entry?.id ?? '';
const slug = raw === 'index' ? '' : raw.replace(/\/index$/, '');

const { notes } = scanNotes();
const items = notes
  .filter((n) => n.slug !== '')
  .sort((a, b) => a.title.localeCompare(b.title, 'ja'));
---

<div class="kb-side">
  <a class="kb-wordmark" href="/">snowyuki31</a>
  <nav class="kb-index" aria-label="Index">
    <ul>
      {
        items.map((n) => (
          <li>
            <a href={`/${n.slug}/`} aria-current={slug === n.slug ? 'page' : undefined}>
              {n.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
